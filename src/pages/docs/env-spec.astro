---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsNavLeft from "../../components/docs/DocsNavLeft.astro";
import DocsOnThisPage from "../../components/docs/DocsOnThisPage.astro";
import DocsEnvSpecArticle from "../../components/docs/DocsEnvSpecArticle.astro";
import { envSpecNav, envSpecSections } from "../../content/site/env-spec";
---

<BaseLayout
  title="mvmctl env spec · Environment workflow YAML reference"
  description="The mvm env YAML reference for 0.3.0: workflow dependencies, resource steps, guest commands, and cleanup behavior."
>
  <div class="docs-shell">
    <DocsNavLeft items={envSpecNav} />
    <DocsEnvSpecArticle />
    <DocsOnThisPage toc={envSpecSections.map(({ id, title }) => ({ id, label: title }))} />
  </div>
</BaseLayout>

<style>
  .docs-shell {
    width: calc(100vw - 2rem);
    max-width: 1320px;
    margin: 0 auto 5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    gap: 2rem;
  }

  .docs-shell :global(.left-nav) {
    grid-column: 1;
  }

  .docs-shell :global(.article) {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1200px) {
    .docs-shell {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  @media (max-width: 980px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .docs-shell :global(.left-nav),
    .docs-shell :global(.article) {
      grid-column: 1;
    }
    .docs-shell :global(.article) {
      width: min(100%, 72ch);
      justify-self: center;
    }
  }
</style>
