---
import DocsPage from "../../../components/docs/DocsPage.astro";
import DocsMarkdownArticle from "../../../components/docs/DocsMarkdownArticle.astro";
import * as commands from "../../../content/reference/0.2/commands.md";
import * as environment from "../../../content/reference/0.2/environment.md";
import { archiveNav, archivePath, makeArchiveToc, makeArchiveNav } from "../../../content/site/docs-archive";

export function getStaticPaths() {
  return [
    { params: { guide: "reference" }, props: { title: "Command reference", manual: commands } },
    { params: { guide: "env-spec" }, props: { title: "Environment spec", manual: environment } },
  ];
}

const { title, manual } = Astro.props;
const { Content, getHeadings } = manual;
const toc = makeArchiveToc(getHeadings());
---

<DocsPage
  title={`${title} · mvmctl 0.2`}
  description={`${title} for mvmctl v0.2.0.`}
  canonicalPath={`${archivePath}/${Astro.params.guide}/`}
  items={[...archiveNav, ...makeArchiveNav(toc)]}
  {toc}
>
  <DocsMarkdownArticle><Content /></DocsMarkdownArticle>
</DocsPage>
