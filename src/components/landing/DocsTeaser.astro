---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { docsTeaser } from "../../content/site/landing";
---

<Section title={docsTeaser.title} description={docsTeaser.description}>
  <div class="teaser" data-anim="docs-teaser">
    <div>
      <p><a href="/docs/0.3/reference/">Command reference</a></p>
      <p><a href="/docs/0.3/env-spec/">Environment blueprint reference</a></p>
      <p><a href="/llm.txt">AI reference (llm.txt)</a> · Full commands and blueprint directives in plain text</p>
    </div>
    <div class="teaser-action">
      <Button href={docsTeaser.cta.href} label={docsTeaser.cta.label} iconLeft="book" iconRight={true} />
    </div>
  </div>
</Section>

<style>
  .teaser {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1rem;
    background: linear-gradient(
      135deg,
      var(--color-surface-card-94-start),
      var(--color-surface-card-94-end)
    );
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-color: var(--color-border-soft);
    transition: border-color 180ms ease;
    min-width: 0;
    overflow: hidden;
  }

  .teaser > div {
    min-width: 0;
    max-width: 100%;
  }

  .teaser:hover {
    border-color: var(--color-accent-primary-62);
  }

  .teaser-action {
    flex: 0 0 auto;
    min-width: 0;
    max-width: 100%;
    width: fit-content;
  }

  .teaser-action :global(.btn) {
    width: auto;
    justify-content: center;
  }

  .teaser-action :global(.btn.primary) {
    background: var(--gradient-btn-primary);
  }

  .teaser-action :global(.btn.primary:hover),
  .teaser-action :global(.btn.primary:focus-visible) {
    background: var(--gradient-btn-primary-hover);
  }

  .teaser-action :global(.btn.primary:active) {
    background: var(--gradient-btn-primary-active);
  }

  .teaser p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.65;
    overflow-wrap: anywhere;
    word-break: break-word;
    hyphens: auto;
    transition: color 180ms ease;
  }

  .teaser a {
    color: var(--color-accent-primary);
    text-decoration: underline;
  }

  .teaser:hover p {
    color: var(--color-text-list);
  }

  @media (max-width: 780px) {
    .teaser {
      flex-direction: column;
      align-items: stretch;
    }

    .teaser-action {
      align-self: flex-start;
      width: fit-content;
      max-width: 100%;
    }

    .teaser p {
      font-size: 1rem;
      line-height: 1.58;
    }
  }

  @media (max-width: 420px) {
    .teaser {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .teaser p {
      font-size: 0.75rem;
      line-height: 1.42;
    }
  }

  @media (max-width: 280px) {
    .teaser {
      padding: 0.5rem;
      gap: 0.5rem;
    }

    .teaser p {
      font-size: 0.75rem;
      line-height: 1.34;
    }

    .teaser-action :global(.btn) {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      line-height: 1.2;
    }
  }
</style>
