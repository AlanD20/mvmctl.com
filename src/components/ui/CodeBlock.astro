---
import "../../styles/code-block.css";
import { codeToHtml } from "shiki";
import Icon from "./Icon.astro";
import { getIcon } from "../../lib/icons";

interface Props {
  lines: readonly string[];
  caption?: string;
  compact?: boolean;
}

const { lines, caption, compact = false } = Astro.props;
const code = lines.join("\n");

let highlighted: string;
try {
  highlighted = await codeToHtml(code, {
    lang: "bash",
    theme: "vitesse-dark",
  });
} catch {
  // Fallback: wrap in <code> if shiki fails
  highlighted = `<pre class="shiki fallback"><code>${code}</code></pre>`;
}
---

<div class={`code-wrap ${compact ? "compact" : ""}`}>
  <div class="code-top">
    <div class="code-top-label">
      <Icon icon={getIcon("terminal")} size="0.75rem" class="code-terminal-icon" />
      <p class="code-caption">{caption ?? "Terminal"}</p>
    </div>
    <div class="code-top-actions"></div>
  </div>
  <div set:html={highlighted} class="code-body" data-anim="code-block" />
</div>
