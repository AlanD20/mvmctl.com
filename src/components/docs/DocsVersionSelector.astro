---
import { docsVersions } from "../../content/site/docs";

interface Props {
  canonicalPath: string;
}

const { canonicalPath } = Astro.props;
const currentVersion = docsVersions.find(({ path }) => canonicalPath.startsWith(`${path}/`));
if (!currentVersion) {
  throw new Error(`No documentation version registered for ${canonicalPath}`);
}
const currentGuide = canonicalPath.slice(currentVersion.path.length);
const sharedGuide = currentGuide === "/reference/" || currentGuide === "/env-spec/" ? currentGuide : "/";
---

<details class="version-selector">
  <summary>
    Docs version <strong>{currentVersion.label}</strong>
    {currentVersion.prerelease && <span class="version-status">Prerelease</span>}
  </summary>
  <ul>
    {docsVersions.map((version) => (
      <li>
        <a
          href={version === currentVersion ? canonicalPath : `${version.path}${sharedGuide}`}
          aria-current={version === currentVersion ? "page" : undefined}
        >
          {version.label}
          {version !== currentVersion && version.prerelease && <span class="version-status">Prerelease</span>}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .version-selector {
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-border-light);
    border-radius: 0.5rem;
    background: var(--color-surface-4);
    color: var(--text);
    font-size: 0.8125rem;
  }

  summary,
  a {
    padding: 0.5rem;
    color: inherit;
  }

  summary {
    cursor: pointer;
  }

  summary:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: -2px;
    border-radius: 0.5rem;
  }

  .version-status {
    display: inline-block;
    margin-inline-start: 0.25rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: var(--color-surface-selected);
    color: var(--color-text-list);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  ul {
    margin: 0;
    padding: 0.25rem;
    border-top: 1px solid var(--color-border-light);
    list-style: none;
  }

  a {
    display: block;
    border-radius: 0.375rem;
    text-decoration: none;
  }

  a[aria-current] {
    font-weight: 600;
  }

  summary:hover,
  a:hover {
    background: var(--color-surface-selected-hover);
  }
</style>
